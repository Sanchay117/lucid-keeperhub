# KeeperHub organization API key. Broadcasting requires the `mcp:write` scope;
# a dry run works with `mcp:read`.
# Create one under Settings > Developer in https://app.keeperhub.com
KEEPERHUB_API_KEY=kh_...

# Chain KeeperHub settles payouts on. 11155111 is Ethereum Sepolia.
KEEPERHUB_CHAIN_ID=11155111

# Where the demo sends its settlement. Use a throwaway testnet address.
DEMO_RECIPIENT=0x0000000000000000000000000000000000000000

# Human-readable amount, e.g. "0.0001". Not wei.
DEMO_AMOUNT=0.0001

# Optional: self-hosted KeeperHub deployment.
# KEEPERHUB_BASE_URL=https://app.keeperhub.com

# --- x402: buyer agents pay the seller in USDC on Base Sepolia ---------------
PAYMENTS_FACILITATOR_URL=https://x402.org/facilitator
PAYMENTS_NETWORK=base-sepolia
# The seller's revenue lands here. Using the KeeperHub org wallet closes the loop.
PAYMENTS_RECEIVABLE_ADDRESS=0x...

# Throwaway testnet buyer wallet for the console's "Buy a payout" button.
# Fund with Base Sepolia USDC at faucet.circle.com; it needs no ETH.
BUYER_PRIVATE_KEY=0x...
BUYER_ADDRESS=0x...
