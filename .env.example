# KeeperHub organization API key. Broadcasting requires the `mcp:write` scope;
# a dry run works with `mcp:read`.
# Create one under Settings > Developer in https://app.keeperhub.com
KEEPERHUB_API_KEY=kh_...

# Chain the demo settles on. 84532 is Base Sepolia (testnet).
KEEPERHUB_CHAIN_ID=84532

# Where the demo sends its settlement. Use a throwaway testnet address.
DEMO_RECIPIENT=0x0000000000000000000000000000000000000000

# Human-readable amount, e.g. "0.0001". Not wei.
DEMO_AMOUNT=0.0001

# Optional: self-hosted KeeperHub deployment.
# KEEPERHUB_BASE_URL=https://app.keeperhub.com
